{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "智汇参谋",
  "version": "1.0.0",
  "identifier": "com.canmou.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "智汇参谋",
        "width": 1280,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: data: blob: filesystem:; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:5173 ws://localhost:5173 http://127.0.0.1:5173 ws://127.0.0.1:5173; frame-src 'self' blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "zh-CN"
      }
    },
    "longDescription": "智汇参谋 - 企业智能助手平台，整合日程、数据、商机、考勤等核心业务管理功能",
    "shortDescription": "企业智能助手",
    "category": "Business",
    "resources": [],
    "copyright": "",
    "licenseFile": null,
    "externalBin": [],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1000000
    }
  },
  "plugins": {
    "deep-link": {
      "domains": [
        {
          "scheme": "canmou"
        }
      ]
    }
  }
}
