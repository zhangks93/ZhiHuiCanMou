{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "oauth-window",
  "description": "Capability for OAuth popup window",
  "windows": ["oauth"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://open.feishu.cn/*" },
        { "url": "https://*.feishu.cn/*" },
        { "url": "https://*.larksuite.com/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://open.feishu.cn/*" },
        { "url": "https://*.feishu.cn/*" },
        { "url": "https://*.larksuite.com/*" },
        { "url": "canmou://auth-callback*" }
      ]
    }
  ]
}
